{
  "description": "Native Stop hook for the seed-gap run",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"$HARNESS_ROOT/hooks/loop-codex-stop-hook.sh\"'",
            "timeout": 21600,
            "statusMessage": "loop review"
          }
        ]
      }
    ]
  }
}
